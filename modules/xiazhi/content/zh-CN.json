    {
      "id": "xiazhi-c1",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "二十四节气按太阳位置划分一年。",
        "en": "The 24 solar terms divide the year by the Sun's position."
      },
      "region": [
        "中国"
      ],
      "period": "现行口径（GB/T 33661-2017 时代）；机制承自传统历法",
      "source_ids": [
        "source-pmo-almanac-qa",
        "source-hko-solar-terms"
      ],
      "knowledge_ids": [
        "sci-solarterms-calendar-role"
      ],
      "reviewer": "aiwindyjm",
      "reviewed_at": "2026-09-28"
    },
    {
      "id": "xiazhi-c2",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "夏至是第十个节气。太阳到达黄经90°，北半球白昼最长。",
        "en": "Xiazhi is the tenth term: the Sun reaches 90°, the longest day in the Northern Hemisphere."
      },
      "region": [
        "北半球（命题为半球级表述）；例证数据来自中国北京、黑龙江漠河"
      ],
      "period": "现代天文口径；2026年新华社稿含当年实测预报数据",
      "source_ids": [
        "source-xinhua-xiazhi-2026",
        "source-weathercn-xiazhi-feature"
      ],
      "knowledge_ids": [
        "sci-xiazhi-longest-day"
      ],
      "reviewer": "aiwindyjm",
      "reviewed_at": "2026-09-28"
    },
    {
      "id": "xiazhi-c3",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "夏至是农历五月的\"中气\"。在古代，夏至曾是一个重要节日。",
        "en": "Xiazhi is the mid-term of the fifth lunar month. It was historically a major festival."
      },
      "region": [
        "中国（传统历法编算规则）"
      ],
      "period": "现行农历编算口径；GB/T 33661-2017 为现行国家标准（正文条款待人工核读）",
      "source_ids": [
        "source-pmo-almanac-qa",
        "source-yueling-qishierhou-wikisource"
      ],
      "knowledge_ids": [
        "sci-solarterms-jieqi-zhongqi"
      ],
      "reviewer": "aiwindyjm",
      "reviewed_at": "2026-09-28"
    },
    {
      "id": "xiazhi-c4",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "阳光最充足。过了这一天，白昼开始变短。",
        "en": "Peak sunlight. After this day, days begin to shorten."
      },
      "region": [
        "北半球（命题为半球级表述）；例证数据来自中国北京、黑龙江漠河"
      ],
      "period": "现代天文口径；2026年新华社稿含当年实测预报数据",

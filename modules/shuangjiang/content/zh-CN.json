    {
      "id": "shuangjiang-c2",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "霜降是第十八个节气。太阳到达黄经210°，初霜出现。",
        "en": "Shuangjiang is the eighteenth term: the Sun reaches 210°. First frost appears."
      },
      "region": [
        "全球（黄经定义与地域无关）；日期经验因纬度而异"
      ],
      "period": "现代天文学口径；2017年起有国家标准表述（GB/T 33661-2017 正文待人工核读）",
      "source_ids": [

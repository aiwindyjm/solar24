      "reviewed_at": "2026-09-28"
    },
    {
      "id": "shuangjiang-c3",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "霜降是农历九月的\"中气\"，秋天的最后一个节气。",
        "en": "Shuangjiang is the final mid-term of autumn in the ninth lunar month."
      },
      "region": [
        "全球（黄经定义与地域无关）；日期经验因纬度而异"
      ],
      "period": "现代天文学口径；2017年起有国家标准表述（GB/T 33661-2017 正文待人工核读）",
      "source_ids": [

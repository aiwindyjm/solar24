    {
      "id": "jingzhe-c4",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "气温回升，第一声春雷响起。土壤解冻，虫子开始活动。",
        "en": "Rising temperatures bring the first thunder. Soil thaws and insects stir."
      },
      "region": [
        "中国（初雷日期随纬度显著不同）"
      ],
      "period": "当代气候口径（机构科普稿转述）",

    },
    {
      "id": "liqiu-c2",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "立秋是二十四节气中的第十三个：太阳到达黄经135°，秋季第一个节气。",
        "en": "Liqiu is the thirteenth term and first of autumn: the Sun reaches 135°."
      },
      "region": [
        "全球（黄经定义与地域无关）；日期经验因纬度而异"
      ],
      "period": "现代天文学口径；2017年起有国家标准表述",
      "source_ids": [
        "source-ihchina-liqiu-feature",
        "source-xinhua-liqiu-2022"
      ],
      "knowledge_ids": [
        "sci-liqiu-longitude-135"
      ],
      "reviewer": "aiwindyjm",
      "reviewed_at": "2026-09-28"
    },
    {
      "id": "liqiu-c3",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "立秋是农历七月的\"节\"（节气），与处暑（中气）配对。",
        "en": "Liqiu is the jie (node term) of the seventh lunar month, paired with Chushu."
      },
      "region": [
        "中国（传统历法编算规则）"
      ],
      "period": "现行农历编算口径；GB/T 33661-2017 为现行国家标准（正文条款待人工核读）",
      "source_ids": [

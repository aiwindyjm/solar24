      "reviewed_at": "2026-09-28"
    },
    {
      "id": "lidong-c4",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "气温下降，北方地区可能出现初雪。",
        "en": "Temperatures drop; northern regions may see first snow."
      },
      "region": [
        "中国（入冬日期自北向南大幅延后；华南沿海无冬、青藏高原长冬无夏）"
      ],
      "period": "现代气候学口径（候温法）；引用统计为1981-2010常年值与2023年稿数据",
      "source_ids": [
        "source-szmb-season-division",

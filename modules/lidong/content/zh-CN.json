    {
      "id": "lidong-c5",
      "kind": "fact",
      "text": {
        "zh-CN": "古人观察到：水开始结冰、地面开始冻结、野鸡飞入大海变成蛤蜊。",
        "en": "Ancient texts: water begins to freeze, ground starts to harden, pheasants vanish into the sea."
      },
      "region": [
        "文本经验锚定中国（黄河流域为核心的古典物候传统）；实际物候因纬度海拔而异"
      ],
      "period": "文本传统题名为元代；所承物候体系更早（《礼记·月令》《吕氏春秋》等）",

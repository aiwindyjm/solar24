    {
      "id": "lidong-c1",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "二十四节气按太阳位置划分一年。",
        "en": "The 24 solar terms divide the year by the Sun's position."
      },
      "region": [
        "中国"
      ],
      "period": "现行口径（GB/T 33661-2017 时代）；机制承自传统历法",
      "source_ids": [
        "source-pmo-almanac-qa",
        "source-hko-solar-terms"
      ],
      "knowledge_ids": [
        "sci-solarterms-calendar-role"
      ],
      "reviewer": "aiwindyjm",
      "reviewed_at": "2026-09-28"
    },
    {
      "id": "lidong-c2",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "立冬是第十九个节气。太阳到达黄经225°，冬季开始。",
        "en": "Lidong is the nineteenth term: the Sun reaches 225°. Winter begins."
      },
      "region": [
        "全球（黄经定义与地域无关）；日期经验因纬度而异"
      ],
      "period": "现代天文学口径；2017年起有国家标准表述",
      "source_ids": [
        "source-ihchina-lidong-feature",
        "source-weathercn-lidong-225"
      ],
      "knowledge_ids": [
        "sci-lidong-longitude-225"
      ],
      "reviewer": "aiwindyjm",
      "reviewed_at": "2026-09-28"
    },
    {
      "id": "lidong-c3",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "立冬是农历十月的\"节\"。",
        "en": "Lidong is the node term of the tenth lunar month."
      },
      "region": [
        "中国（传统历法编算规则）"
      ],
      "period": "现行农历编算口径；GB/T 33661-2017 为现行国家标准（正文条款待人工核读）",
      "source_ids": [
        "source-pmo-almanac-qa",
        "source-yueling-qishierhou-wikisource"
      ],
      "knowledge_ids": [
        "sci-solarterms-jieqi-zhongqi"
      ],

    {
      "id": "xiaoman-c2",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "小满是二十四节气中的第八个：太阳到达黄经60°。",
        "en": "Xiaoman is the eighth term: the Sun reaches 60°."
      },
      "region": [
        "全球（黄经定义与地域无关）；日期经验因纬度而异"
      ],
      "period": "现代天文学口径；2017年机构专题与2024年机构稿沿用同一表述",
      "source_ids": [

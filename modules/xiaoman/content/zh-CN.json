      ],
      "reviewer": "aiwindyjm",
      "reviewed_at": "2026-09-28"
    },
    {
      "id": "xiaoman-c4",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "小满时节气温升高，北方冬小麦进入灌浆期。",
        "en": "Rising temperatures bring winter wheat into its grain-filling stage."
      },
      "region": [
        "全球（黄经定义与地域无关）；日期经验因纬度而异"
      ],
      "period": "现代天文学口径；2017年机构专题与2024年机构稿沿用同一表述",

      "reviewed_at": "2026-09-28"
    },
    {
      "id": "xiaoman-c3",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "小满是农历四月的\"中气\"。名称意为麦粒开始饱满但未全熟。",
        "en": "Xiaoman is the zhongqi of the fourth lunar month, meaning grain begins to fill but is not yet ripe."
      },
      "region": [
        "中国（传统历法编算规则）"
      ],
      "period": "现行农历编算口径；GB/T 33661-2017 为现行国家标准（正文条款待人工核读）",
      "source_ids": [
        "source-pmo-almanac-qa",
        "source-yueling-qishierhou-wikisource"
      ],
      "knowledge_ids": [

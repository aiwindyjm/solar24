    },
    {
      "id": "qiufen-c2",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "秋分是第十六个节气。太阳到达黄经180°，全球昼夜几乎等长。",
        "en": "Qiufen is the sixteenth term: the Sun reaches 180°. Day and night are nearly equal worldwide."
      },
      "region": [
        "全球（直射赤道事件全球同时；昼夜相对长度随纬度而异）"
      ],
      "period": "现代天文学口径；汉代文本为对照层",
      "source_ids": [
        "source-ihchina-qiufen-feature",
        "source-xinhua-qiufen-2022"
      ],
      "knowledge_ids": [
        "sci-qiufen-day-night-equal"
      ],
      "reviewer": "aiwindyjm",
      "reviewed_at": "2026-09-28"
    },
    {
      "id": "qiufen-c3",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "秋分是农历八月的\"中气\"，通常在中秋节前后。",
        "en": "Qiufen is the mid-term of the eighth lunar month, typically near the Mid-Autumn Festival."
      },
      "region": [
        "中国（传统历法编算规则）"
      ],
      "period": "现行农历编算口径；GB/T 33661-2017 为现行国家标准（正文条款待人工核读）",
      "source_ids": [

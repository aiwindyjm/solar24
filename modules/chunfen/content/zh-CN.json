    {
      "id": "chunfen-c1",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "二十四节气按太阳黄经等分黄道24段。节气是太阳位置的刻度。",
        "en": "The 24 solar terms mark the Sun's position along the ecliptic."
      },
      "region": [
        "中国"
      ],
      "period": "现行口径（GB/T 33661-2017 时代）；机制承自传统历法",
      "source_ids": [
        "source-pmo-almanac-qa",
        "source-hko-solar-terms"
      ],
      "knowledge_ids": [
        "sci-solarterms-calendar-role"
      ],
      "reviewer": "aiwindyjm",
      "reviewed_at": "2026-09-28"
    },
    {
      "id": "chunfen-c2",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "春分是二十四节气中的第四个：太阳到达黄经0°（春分点），全球昼夜几乎等长。",
        "en": "Chunfen (Spring Equinox) is the fourth term: the Sun reaches 0°, with nearly equal day and night worldwide."
      },
      "region": [
        "全球（黄经定义与地域无关）；日期经验因纬度而异"
      ],
      "period": "现代天文学口径",
      "source_ids": [
        "source-xinhuanet-chunfen-2021",
        "source-xinhuanet-chunfen-2022"
      ],
      "knowledge_ids": [
        "sci-chunfen-longitude-0"
      ],
      "reviewer": "aiwindyjm",
      "reviewed_at": "2026-09-28"
    },
    {
      "id": "chunfen-c3",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "春分是农历二月的\"中气\"，与惊蛰配对。",
        "en": "Chunfen is the zhongqi of the second lunar month, paired with Jingzhe."
      },
      "region": [
        "中国（传统历法编算规则）"
      ],
      "period": "现行农历编算口径；GB/T 33661-2017 为现行国家标准（正文条款待人工核读）",
      "source_ids": [
        "source-pmo-almanac-qa",
        "source-yueling-qishierhou-wikisource"
      ],
      "knowledge_ids": [
        "sci-solarterms-jieqi-zhongqi"
      ],

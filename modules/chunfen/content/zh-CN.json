    },
    {
      "id": "chunfen-c4",
      "kind": "scientific-explanation",
      "text": {
        "zh-CN": "春分日全球各地昼夜接近等长（精确等长需考虑大气折射和太阳视半径）。",
        "en": "Day and night are nearly equal everywhere (exact equality varies with atmospheric refraction)."
      },
      "region": [
        "全球（昼夜相对长度规律与纬度相关，直射赤道事件全球同时）"
      ],
      "period": "现代天文学口径",
      "source_ids": [

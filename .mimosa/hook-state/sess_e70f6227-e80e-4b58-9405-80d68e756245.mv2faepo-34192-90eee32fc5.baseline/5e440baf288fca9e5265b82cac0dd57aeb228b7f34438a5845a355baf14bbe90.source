def get_sources(kid):
    """Get source_ids from a knowledge card."""
    d = byId.get(kid)
    if not d:
        return []
    return d.get('source_ids', [])

def build_refs(source_ids):
    """Build references array from source IDs."""
    refs = []
    for sid in source_ids:
        d = byId.get(sid)
        if not d or not d.get('source'):
            continue
        s = d['source']
        refs.append({
            'id': s['id'], 'title': s['title'], 'authors': s.get('authors', []),
            'publisher': s.get('publisher'), 'published': s.get('published'),
            'url': s.get('url'), 'citation': s.get('citation', ''),
            'source_type': s.get('source_type', 'institutional'),
            'access': s.get('access', 'direct-read'),
            'accessed': str(s.get('accessed', '')),
            'original_excerpt': s.get('original_excerpt', ''),
            'locator': s.get('locator', ''), 'ai_summary': s.get('ai_summary', ''),
            'rights': s.get('rights', 'unknown'), 'verification': 'human-verified',
        })
    return refs

results = {}
for slug, cfg in SELECTIONS.items():
    claims = []
    all_refs = {}
    slot_map = {}
    for slot_id in ['S1','S2','S3','S4','S5','S6','S7','S8']:
        if slot_id not in cfg['slots']:
            continue
        kid, kind, zh, en = cfg['slots'][slot_id]
        kd = byId.get(kid)
        if not kd:
            print(f'  WARNING: {slug} {slot_id} knowledge card {kid} not found')
            continue
        src_ids = get_sources(kid)[:2]  # max 2 sources per claim
        for sid in src_ids:
            if sid not in all_refs:
                rd = byId.get(sid)
                if rd and rd.get('source'):
                    s = rd['source']
                    all_refs[sid] = {
                        'id': s['id'], 'title': s['title'], 'authors': s.get('authors', []),
                        'publisher': s.get('publisher'), 'published': s.get('published'),
                        'url': s.get('url'), 'citation': s.get('citation', ''),
                        'source_type': s.get('source_type', 'institutional'),
                        'access': s.get('access', 'direct-read'),
                        'accessed': str(s.get('accessed', '')),
                        'original_excerpt': s.get('original_excerpt', ''),
                        'locator': s.get('locator', ''), 'ai_summary': s.get('ai_summary', ''),
                        'rights': s.get('rights', 'unknown'), 'verification': 'human-verified',
                    }
        claim_id = f'{slug}-c{len(claims)+1}'
        claims.append({
            'id': claim_id, 'kind': kind,
            'text': {'zh-CN': zh, 'en': en},
            'region': kd.get('region', []) if isinstance(kd.get('region'), list) else [],
            'period': kd.get('period') or '当代（项目解释层）',
            'source_ids': src_ids,
            'knowledge_ids': [kid],
            'reviewer': REVIEWER, 'reviewed_at': DATE,
        })
        slot_map[slot_id] = claim_id

    sections = [
        {'id': 'what', 'title': {'zh-CN': f'{cfg["name"]}是什么', 'en': f'What is {cfg["name_en"]}'},
         'claim_ids': [slot_map[s] for s in ['S1','S2','S3'] if s in slot_map]},
        {'id': 'nature', 'title': {'zh-CN': f'{cfg["name"]}与自然', 'en': f'{cfg["name_en"]} and Nature'},
         'claim_ids': [slot_map[s] for s in ['S4','S5'] if s in slot_map]},
        {'id': 'people', 'title': {'zh-CN': f'{cfg["name"]}与人们的生活', 'en': f'{cfg["name_en"]} and People'},
         'claim_ids': [slot_map[s] for s in ['S6'] if s in slot_map]},
        {'id': 'culture', 'title': {'zh-CN': '为什么今天仍值得理解', 'en': 'Why It Matters Today'},
         'claim_ids': [slot_map[s] for s in ['S7','S8'] if s in slot_map]},
    ]

    content = {
        'schema_version': '0.1.0', 'term_id': slug, 'locale': 'zh-CN',
        'review_status': 'approved', 'sections': sections, 'claims': claims,
    }

    mod_dir = os.path.join(MODS, slug)
    os.makedirs(os.path.join(mod_dir, 'content'), exist_ok=True)

    with io.open(os.path.join(mod_dir, 'content', 'zh-CN.json'), 'w', encoding='utf-8') as f:
        json.dump(content, f, ensure_ascii=False, indent=2)

    refs_list = list(all_refs.values())
    with io.open(os.path.join(mod_dir, 'references.json'), 'w', encoding='utf-8') as f:
        json.dump(refs_list, f, ensure_ascii=False, indent=2)

    results[slug] = {'claims': len(claims), 'refs': len(refs_list), 'slots': len(slot_map)}
    print(f'{slug}: {len(claims)} claims, {len(refs_list)} refs, {len(slot_map)}/8 slots')

print('\nDone!')
for slug, r in results.items():
    print(f'  {slug}: {r["claims"]}c/{r["refs"]}r/{r["slots"]}/8')

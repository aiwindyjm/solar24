async page => {
 const errors=[]; page.on('pageerror',e=>errors.push(e.message));
 const check=(ok,label)=>{if(!ok)throw new Error(label);};
 await page.setViewportSize({width:1269,height:1066});
 await page.goto('http://127.0.0.1:5176/#jingzhe/seasons');
 await page.waitForTimeout(2000);
 const dial=()=>page.locator('.wheel-layer').boundingBox();
 const before=await dial();
 await page.locator('.culture-strip button').nth(0).click();
 await page.waitForTimeout(250);
 const mid=await page.locator('.scroll-paper').evaluate(el=>getComputedStyle(el).clipPath);
 await page.screenshot({path:'output/playwright/solar24-v5-scroll-unrolling.png'});
 await page.waitForTimeout(750);
 const after=await dial();
 check(JSON.stringify(before)===JSON.stringify(after),'Dial must not move or resize');
 check(mid!=='inset(0px 0px 0px 0px)' && mid!=='inset(0% 0% 0% 100%)','Intermediate unrolling state');
 await page.screenshot({path:'output/playwright/solar24-v5-scroll-open.png'});
 await page.locator('.culture-strip button').nth(4).click();
 check(await page.locator('#chapter-4').getAttribute('open')!==null,'Requested chapter opens');
 await page.locator('.scroll-spine').click();
 await page.waitForTimeout(950);
 check(await page.locator('.scroll-paper').evaluate(el=>el.inert),'Closed paper is inert');
 check(await page.locator('.scroll-paper').isHidden(),'Closed paper hidden');
 await page.getByRole('button',{name:'03Human life',exact:true}).click();
 check(await page.locator('.culture-strip').count()===0,'Life has no book category entrances');
 check(await page.locator('.reading-scroll').count()===0,'Life has no scroll');
 await page.waitForTimeout(2200);
 await page.locator('.hotspots button').nth(0).click();
 await page.getByRole('button',{name:'Listen to this landscape',exact:false}).click();
 check(await page.getByRole('button',{name:'Stop listening',exact:false}).getAttribute('aria-pressed')==='true','Listening starts only on request');
 await page.getByRole('button',{name:'Stop listening',exact:false}).click();
 await page.getByRole('button',{name:'Return to the landscape',exact:true}).click();
 await page.locator('.hotspots button').nth(1).click();
 await page.locator('#field-time').focus();
 await page.keyboard.press('End');
 check(await page.locator('#field-time').inputValue()==='3','Field has keyboard-operable growth control');
 await page.waitForTimeout(2200);
 await page.screenshot({path:'output/playwright/solar24-v5-life-field.png'});
 await page.getByRole('button',{name:'Return to the landscape',exact:true}).click();
 await page.locator('.hotspots button').nth(2).click();
 await page.locator('#season-memory').fill('QA: a bird at the window');
 await page.getByRole('button',{name:'Keep this moment',exact:false}).click();
 await page.reload(); await page.waitForTimeout(1800);
 await page.locator('.hotspots button').nth(2).click();
 check(await page.locator('#season-memory').inputValue()==='QA: a bird at the window','Private memory persists');
 await page.locator('#season-memory').fill('');
 await page.getByRole('button',{name:'Keep this moment',exact:false}).click();
 check(await page.evaluate(()=>localStorage.getItem('solar24-v5-memory-jingzhe'))===null,'Memory can be erased');
 await page.getByRole('button',{name:'Switch to Chinese',exact:true}).click();
 await page.waitForTimeout(1000);
 await page.screenshot({path:'output/playwright/solar24-v5-life-memory-zh.png'});
 await page.setViewportSize({width:390,height:844}); await page.waitForTimeout(1800);
 await page.locator('.life-participation').scrollIntoViewIfNeeded();
 check(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),'No mobile horizontal overflow');
 await page.screenshot({path:'output/playwright/solar24-v5-life-mobile.png',fullPage:true});
 await page.getByRole('button',{name:'01观四时',exact:true}).click();
 await page.locator('.culture-strip button').nth(1).click();
 await page.waitForTimeout(1000);
 await page.screenshot({path:'output/playwright/solar24-v5-scroll-mobile.png'});
 await page.keyboard.press('Escape'); await page.waitForTimeout(900);
 check(await page.locator('.scroll-paper').isHidden(),'Escape rolls up the paper');
 await page.emulateMedia({reducedMotion:'reduce'});
 await page.locator('.scroll-spine').click();
 check(await page.locator('.scroll-paper').evaluate(el=>getComputedStyle(el).transitionDuration)==='0s','Reduced motion opens immediately');
 await page.locator('.scroll-spine').click();
 await page.emulateMedia({reducedMotion:'no-preference'});
 await page.setViewportSize({width:1280,height:720});
 await page.locator('.culture-strip button').nth(0).click(); await page.waitForTimeout(1000);
 await page.screenshot({path:'output/playwright/solar24-v5-scroll-720.png'});
 check(errors.length===0,errors.join(';'));
 return {status:'passed',unchangedDial:before,midClip:mid,errors};
}

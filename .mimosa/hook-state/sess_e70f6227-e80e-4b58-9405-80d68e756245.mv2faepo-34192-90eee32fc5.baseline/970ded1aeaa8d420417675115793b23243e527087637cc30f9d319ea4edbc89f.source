async page => {
 const check=(v,msg)=>{if(!v)throw Error(msg)};
 const errors=[];page.on('pageerror',e=>errors.push(e.message));
 await page.setViewportSize({width:1269,height:1066});
 await page.goto('http://127.0.0.1:5176/#daxue/seasons');
 await page.waitForTimeout(1600);
 if(await page.getByRole('button',{name:'Switch to English',exact:true}).count())await page.getByRole('button',{name:'Switch to English',exact:true}).click();
 const before=await page.locator('.wheel-layer').boundingBox();
 await page.locator('.culture-strip button').first().focus();await page.keyboard.press('Enter');
 await page.waitForTimeout(230);
 const mid=await page.locator('.scroll-mount').evaluate(el=>getComputedStyle(el).clipPath);
 check(!['inset(0px 0px 0px 0px)','inset(0% 0% 0% 100%)'].includes(mid),'Intermediate unfolding');
 await page.screenshot({path:'output/playwright/solar24-v5-handscroll-unrolling.png'});
 await page.waitForTimeout(1100);
 check(JSON.stringify(before)===JSON.stringify(await page.locator('.wheel-layer').boundingBox()),'Dial fixed');
 const coverage=await page.locator('.scroll-mount').boundingBox();
 check(coverage.x===0&&coverage.width===1269&&Math.round(coverage.y+coverage.height)===1066,'Full coverage');
 check(await page.locator('.hero').evaluate(el=>el.inert),'Underlying controls inert');
 check(await page.locator('.scroll-heading').evaluate(el=>document.activeElement===el),'Keyboard focus inside');
 await page.screenshot({path:'output/playwright/solar24-v5-handscroll-en.png'});
 await page.locator('.scroll-contents button').nth(4).click();
 await page.waitForTimeout(200);
 check(await page.locator('#chapter-4').getAttribute('open')!==null,'Index selects chapter');
 const selected=await page.locator('#chapter-4 > summary').boundingBox();
 check(selected.y>=coverage.y&&selected.y+selected.height<1066,'Selected chapter visible');
 await page.locator('#chapter-4 > summary').click();
 check(await page.locator('#chapter-4').getAttribute('open')===null,'Chapter collapses');
 await page.locator('.scroll-contents button').nth(4).click();
 check(await page.locator('#chapter-4').getAttribute('open')!==null,'Index reopens chapter');
 await page.locator('#chapter-4 .chapter-provenance > summary').click();
 check(await page.locator('#chapter-4 .chapter-provenance').getAttribute('open')!==null,'Provenance opens');
 await page.keyboard.press('Escape');await page.waitForTimeout(1150);
 check(await page.locator('.scroll-mount').isHidden(),'Closed surface hidden');
 check(await page.locator('.culture-strip button').first().evaluate(el=>document.activeElement===el),'Focus restored');
 await page.locator('.scroll-spine').click();await page.waitForTimeout(120);
 await page.locator('.scroll-spine').click();await page.waitForTimeout(120);
 await page.locator('.scroll-spine').click();await page.waitForTimeout(1200);
 check(await page.locator('.reading-scroll').evaluate(el=>el.classList.contains('is-open')),'Latest rapid action wins');
 await page.locator('header nav button').nth(2).click();await page.waitForTimeout(2100);
 check(await page.locator('.reading-scroll').count()===0,'Life has no reading scroll');
 check(await page.locator('.culture-strip').count()===0,'Life has no duplicated chapter entrances');
 await page.goBack();await page.waitForTimeout(1800);
 check(await page.locator('.scroll-mount').isHidden(),'Back closes scroll');
 await page.setViewportSize({width:1280,height:720});
 await page.locator('.scroll-spine').click();await page.waitForTimeout(1150);
 await page.screenshot({path:'output/playwright/solar24-v5-handscroll-720.png'});
 const close=await page.locator('.reading-close').boundingBox();
 check(close.y>=0&&close.y+close.height<720,'Persistent close at 720');
 await page.keyboard.press('Escape');await page.waitForTimeout(1150);
 await page.setViewportSize({width:390,height:844});
 await page.evaluate(()=>scrollTo(0,0));await page.waitForTimeout(400);
 const mbefore=await page.locator('.wheel-layer').boundingBox();
 await page.locator('.scroll-spine').click();await page.waitForTimeout(1200);
 check(JSON.stringify(mbefore)===JSON.stringify(await page.locator('.wheel-layer').boundingBox()),'Mobile dial fixed');
 check(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),'No horizontal overflow');
 const mobile=await page.locator('.scroll-mount').boundingBox();
 check(mobile.x===0&&mobile.width===390&&Math.round(mobile.y+mobile.height)===844,'Mobile full coverage');
 await page.screenshot({path:'output/playwright/solar24-v5-handscroll-mobile-en.png'});
 await page.locator('#chapter-2 > summary').click();
 check(await page.locator('#chapter-2').getAttribute('open')!==null,'Mobile chapter opens');
 await page.locator('.reading-close').click();await page.waitForTimeout(1150);
 await page.getByRole('button',{name:'Switch to Chinese',exact:true}).click();
 await page.locator('.culture-strip button').nth(1).click();await page.waitForTimeout(1200);
 check(await page.locator('#chapter-1').getAttribute('open')!==null,'Mobile lower entry selects chapter');
 await page.screenshot({path:'output/playwright/solar24-v5-handscroll-mobile-zh.png'});
 await page.keyboard.press('Escape');await page.waitForTimeout(1150);
 await page.emulateMedia({reducedMotion:'reduce'});
 await page.locator('.scroll-spine').click();
 check(await page.locator('.scroll-mount').evaluate(el=>getComputedStyle(el).transitionDuration)==='0s','Reduced motion instant');
 check(await page.locator('canvas').count()===1,'One renderer');
 await page.keyboard.press('Escape');
 await page.emulateMedia({reducedMotion:'no-preference'});
 check(errors.length===0,'No page errors: '+errors.join(';'));
 return {coverage,mobile,mid,errors,passed:true};
}

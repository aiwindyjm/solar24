updated = 0
for slug, rewrites in REWRITES.items():
    p = os.path.join(MODS, slug, 'content', 'zh-CN.json')
    c = json.load(io.open(p, encoding='utf-8'))
    for idx, (zh, en) in rewrites.items():
        if idx < len(c['claims']):
            c['claims'][idx]['text']['zh-CN'] = zh
            c['claims'][idx]['text']['en'] = en
            updated += 1
    with io.open(p, 'w', encoding='utf-8') as f:
        json.dump(c, f, ensure_ascii=False, indent=2)
    print(f'{slug}: {len(rewrites)} claims rewritten')

print(f'\nTotal: {updated} claims rewritten')

# Verify lengths
over120 = []
for slug in REWRITES:
    p = os.path.join(MODS, slug, 'content', 'zh-CN.json')
    c = json.load(io.open(p, encoding='utf-8'))
    for i, cl in enumerate(c['claims']):
        if len(cl['text']['zh-CN']) > 120:
            over120.append(f'{slug}-c{i+1}: {len(cl["text"]["zh-CN"])} chars')
if over120:
    print(f'\nWARNING: {len(over120)} claims over 120 chars:')
    for x in over120:
        print(f'  {x}')
else:
    print('\nAll claims ≤120 chars ✓')

async page => {
  const check=(v,m)=>{if(!v)throw Error(m)};
  const errors=[], failures=[];
  page.on('pageerror',e=>errors.push(e.message));
  page.on('response',r=>{if(r.status()>=400)failures.push([r.status(),r.url()])});
  await page.setViewportSize({width:1280,height:800});
  await page.goto('https://solar24-demo.solar24.workers.dev/?lang=en#lichun/seasons');
  await page.locator('.dial').waitFor();
  check(await page.locator('html').getAttribute('lang')==='en','English link');
  await page.getByRole('button',{name:'Switch to Chinese',exact:true}).click();
  check(page.url().includes('lang=zh'),'Language changes share URL');
  await page.reload();
  check(await page.locator('html').getAttribute('lang')==='zh-CN','Chinese reload');
  await page.goto('https://solar24-demo.solar24.workers.dev/?lang=en#qiufen/seasons');
  check(await page.locator('html').getAttribute('lang')==='en','Explicit English overrides saved Chinese');
  await page.getByRole('button',{name:'Enter Winter Solstice',exact:true}).click();
  check(page.url().includes('lang=en#dongzhi/seasons'),'Term preserves language');
  await page.goBack();
  check(page.url().includes('#qiufen/seasons'),'Back restores term');
  await page.locator('.culture-strip button').nth(3).click();
  check((await page.locator('.chapter-body > p').first().innerText()).includes('2018'),'Deployed text');
  await page.locator('.reading-references > summary').click();
  check(await page.locator('.reference-books cite').count()>0,'Deployed bibliography');
  await page.locator('.reading-close').click();
  await page.locator('header nav button').nth(1).click();
  await page.waitForTimeout(2100);
  check(await page.locator('canvas').count()===1,'One canvas');
  await page.locator('.lens-switch button').first().click();
  await page.waitForTimeout(2000);
  await page.screenshot({path:'output/playwright/solar24-live-cosmos.png'});
  await page.locator('header nav button').nth(2).click();
  await page.locator('.hotspots button').nth(1).click();
  await page.locator('#field-time').fill('80');
  await page.setViewportSize({width:390,height:844});
  await page.locator('.life-participation').scrollIntoViewIfNeeded();
  check(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),'Mobile overflow');
  await page.screenshot({path:'output/playwright/solar24-live-mobile.png'});
  await page.goto('https://solar24-demo.solar24.workers.dev/?lang=zh#lichun/seasons');
  await page.setViewportSize({width:1280,height:800});
  await page.waitForTimeout(2200);
  await page.screenshot({path:'output/playwright/solar24-live-zh.png'});
  check(await page.locator('html').getAttribute('lang')==='zh-CN','Chinese link');
  check(errors.length===0,'Page errors: '+errors.join());
  check(failures.length===0,'HTTP errors: '+JSON.stringify(failures));
  return {passed:true,errors,failures,url:page.url()};
}

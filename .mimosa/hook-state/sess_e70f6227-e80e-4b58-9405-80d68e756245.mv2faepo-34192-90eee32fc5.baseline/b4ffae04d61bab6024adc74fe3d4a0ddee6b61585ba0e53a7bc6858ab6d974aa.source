updated = 0
for slug, translations in EN_TRANSLATIONS.items():
    p = os.path.join(MODS, slug, 'content', 'zh-CN.json')
    if not os.path.exists(p):
        continue
    c = json.load(io.open(p, encoding='utf-8'))
    for i, claim in enumerate(c['claims']):
        num = i + 1
        if num in translations:
            claim['text']['en'] = translations[num]
            updated += 1
    with io.open(p, 'w', encoding='utf-8') as f:
        json.dump(c, f, ensure_ascii=False, indent=2)
    print(f'{slug}: en updated for {len(translations)} claims')

print(f'\nTotal claims updated: {updated}')

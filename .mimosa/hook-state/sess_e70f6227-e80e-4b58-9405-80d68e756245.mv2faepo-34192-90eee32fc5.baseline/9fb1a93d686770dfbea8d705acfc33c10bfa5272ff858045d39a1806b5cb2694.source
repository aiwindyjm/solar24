async page => {
 const check=(v,m)=>{if(!v)throw Error(m)};
 const errors=[];page.on('pageerror',e=>errors.push(e.message));
 const bounds=async()=>{
  const paper=await page.locator('.reading-scroll').boundingBox();
  const tools=await page.locator('.dial-tools').boundingBox();
  const strip=await page.locator('.culture-strip').boundingBox();
  check(paper.y+paper.height<=tools.y,'Reading ends above tools');
  check(paper.y+paper.height<=strip.y,'Reading ends above categories');
  return {paper,tools,strip};
 };
 await page.setViewportSize({width:1269,height:1066});
 await page.goto('http://127.0.0.1:5176/#daxue/seasons');await page.waitForTimeout(1800);
 const before=await page.locator('.wheel-layer').boundingBox();
 await page.locator('.culture-strip button').first().focus();await page.keyboard.press('Enter');await page.waitForTimeout(1150);
 check(JSON.stringify(before)===JSON.stringify(await page.locator('.wheel-layer').boundingBox()),'Wheel unchanged');
 const desktop=await bounds();
 for(const selector of ['.culture-strip','.dial-tools','.time-dock'])check(await page.locator(selector).evaluate(el=>!el.closest('[inert]')),'Controls not inert '+selector);
 await page.locator('.culture-strip button').nth(4).click();await page.waitForTimeout(120);
 check(await page.locator('#chapter-4').getAttribute('open')!==null,'External category switches open chapter');
 const target=await page.locator('#chapter-4 > summary').boundingBox();
 check(target.y>=desktop.paper.y&&target.y+target.height<=desktop.paper.y+desktop.paper.height,'Chapter brought into view');
 const bagua=await page.locator('.dial-tools button').first().getAttribute('aria-pressed');
 await page.locator('.dial-tools button').first().click();
 check(await page.locator('.dial-tools button').first().getAttribute('aria-pressed')!==bagua,'Trigrams work during reading');
 await page.locator('.dial-tools button').last().click();await page.waitForTimeout(1100);
 check(await page.locator('.dial-tools button').last().getAttribute('aria-pressed')==='true','Tour starts during reading');
 check(await page.locator('.scroll-mount').isHidden(),'Tour rolls up reading');
 check(page.url().includes('lichun'),'Tour starts with Lichun');
 await page.locator('.dial-tools button').last().click();
 await page.locator('.culture-strip button').first().click();await page.waitForTimeout(1600);
 const springColor=await page.locator('.scroll-mount').evaluate(el=>getComputedStyle(el).backgroundImage);
 await page.screenshot({path:'output/playwright/solar24-v5-veil-lichun.png'});
 await page.locator('.stepper button').last().click();await page.waitForTimeout(1700);
 check(page.url().includes('yushui'),'Calendar next changes term during reading');
 const rainColor=await page.locator('.scroll-mount').evaluate(el=>getComputedStyle(el).backgroundImage);
 check(springColor!==rainColor,'Reading palette follows term');
 check(await page.locator('.scroll-title').innerText()==='雨水','Title follows term');
 await page.locator('.date-trigger').click();
 check(await page.locator('#calendar').isVisible(),'Calendar remains available');
 await page.keyboard.press('Escape');
 await page.locator('.culture-strip button').nth(1).click();await page.keyboard.press('Escape');await page.waitForTimeout(1100);
 check(await page.locator('.culture-strip button').nth(1).evaluate(el=>document.activeElement===el),'Focus returns to last chapter entrance');
 await page.setViewportSize({width:1280,height:720});
 await page.locator('.culture-strip button').first().click();await page.waitForTimeout(1100);
 const short=await bounds();
 await page.screenshot({path:'output/playwright/solar24-v5-veil-720.png'});
 await page.keyboard.press('Escape');await page.waitForTimeout(1100);
 await page.setViewportSize({width:390,height:844});
 await page.locator('.culture-strip button').first().click();await page.waitForTimeout(1100);
 const mobile=await bounds();
 check(mobile.strip.y+mobile.strip.height<=844,'Mobile categories visible together with reading');
 check(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),'No horizontal overflow');
 await page.screenshot({path:'output/playwright/solar24-v5-veil-mobile.png'});
 await page.locator('.culture-strip button').nth(2).click();await page.waitForTimeout(100);
 check(await page.locator('#chapter-2').getAttribute('open')!==null,'Mobile external chapter selection works');
 await page.locator('.dial-tools button').first().click();
 await page.keyboard.press('Escape');await page.waitForTimeout(1100);
 await page.emulateMedia({reducedMotion:'reduce'});
 await page.locator('.culture-strip button').first().click();
 check(await page.locator('.scroll-mount').evaluate(el=>getComputedStyle(el).transitionDuration)==='0s','Reduced motion');
 await page.keyboard.press('Escape');
 await page.emulateMedia({reducedMotion:'no-preference'});
 check(await page.locator('canvas').count()===1,'One canvas');check(errors.length===0,errors.join(';'));
 return {desktop,short,mobile,springColor,rainColor,errors,passed:true};
}

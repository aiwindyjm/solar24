async page => {
  const errors = [];
  page.on('pageerror', error => errors.push(error.message));
  const check = (value, label) => { if (!value) throw new Error(label); };
  await page.setViewportSize({width:1258,height:1066});
  await page.goto('http://127.0.0.1:5176/#lichun/seasons');
  if (await page.getByRole('button', {name:'Switch to English',exact:true}).isVisible()) {
    await page.getByRole('button', {name:'Switch to English',exact:true}).click();
  }
  await page.locator('.culture-strip button').nth(0).click();
  check(await page.locator('.book-chapter').count() === 5, 'Five chapters');
  await page.locator('#chapter-1 > summary').click();
  check(await page.locator('#chapter-0').getAttribute('open') !== null, 'Chapters expand independently');
  await page.locator('#chapter-1 > summary').focus();
  await page.keyboard.press('Enter');
  await page.waitForFunction(() => !document.querySelector('#chapter-1').open, null, {timeout:3000});
  check(await page.locator('#chapter-1').getAttribute('open') === null, 'Keyboard collapses chapter');
  await page.locator('.culture-strip button').nth(1).click();
  check(await page.locator('#chapter-1').getAttribute('open') !== null, 'Category entrance reopens chapter');
  await page.locator('#chapter-1 .chapter-provenance > summary').click();
  check(await page.locator('#chapter-1 .chapter-provenance a').count() > 0, 'Sources present');
  await page.locator('#chapter-1 .chapter-provenance > summary').click();
  await page.locator('#chapter-0 > summary').click();
  await page.locator('.reading-rail').evaluate(el => el.scrollTop = 0);
  await page.waitForTimeout(2200);
  await page.screenshot({path:'output/playwright/solar24-v5-book-en.png'});
  await page.getByRole('button', {name:'Switch to Chinese',exact:true}).click();
  await page.waitForTimeout(600);
  check((await page.locator('#chapter-1 .chapter-body > p').first().innerText()).includes('东风解冻'), 'Chinese editorial content');
  await page.screenshot({path:'output/playwright/solar24-v5-book-zh.png'});
  await page.setViewportSize({width:1280,height:720});
  await page.waitForTimeout(2200);
  check(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth), 'Desktop no horizontal overflow');
  await page.screenshot({path:'output/playwright/solar24-v5-book-720.png'});
  await page.setViewportSize({width:390,height:844});
  await page.waitForTimeout(2200);
  await page.locator('.reading-rail').scrollIntoViewIfNeeded();
  check(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth), 'Mobile no horizontal overflow');
  check(await page.locator('.reading-rail').evaluate(el => getComputedStyle(el).position === 'relative'), 'Mobile book in document flow');
  await page.screenshot({path:'output/playwright/solar24-v5-book-mobile-zh.png',fullPage:true});
  await page.getByRole('button', {name:'Switch to English',exact:true}).click();
  await page.waitForTimeout(500);
  await page.locator('.reading-rail').scrollIntoViewIfNeeded();
  await page.screenshot({path:'output/playwright/solar24-v5-book-mobile-en.png',fullPage:true});
  await page.getByRole('button', {name:'Close story',exact:true}).click();
  await page.setViewportSize({width:1258,height:1066});
  await page.getByRole('button', {name:'Journey through a year',exact:true}).click();
  await page.locator('.date-trigger').click();
  const before = await page.locator('.date-trigger b').innerText();
  await page.waitForTimeout(1500);
  const after = await page.locator('.date-trigger b').innerText();
  check(before !== after, 'Real-time timer ticks with calendar open');
  await page.getByRole('button', {name:'Pause motion',exact:true}).click();
  await page.screenshot({path:'output/playwright/solar24-v5-book-calendar.png'});
  await page.getByRole('button', {name:'Close calendar',exact:true}).click();
  await page.getByRole('button', {name:'Stay here',exact:true}).click();
  await page.getByRole('button', {name:'Resume motion',exact:true}).click();
  check(await page.locator('canvas').count() === 1, 'One persistent renderer');
  check(errors.length === 0, `Runtime errors: ${errors.join('; ')}`);
  return {status:'passed', checks:12, screenshots:6, dateBefore:before, dateAfter:after, errors};
}

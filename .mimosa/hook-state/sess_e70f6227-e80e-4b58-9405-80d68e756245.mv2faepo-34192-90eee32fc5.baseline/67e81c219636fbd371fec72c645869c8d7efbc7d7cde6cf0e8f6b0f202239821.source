import io

KB = r'E:\Users\Administrator\Documents\Desktop\24节气\knowledge-base'

# R10/R11: update shoushitongkao source
p = KB + r'\04_sources\source-wikisource-shoushitongkao.md'
t = io.open(p, encoding='utf-8').read()
t = t.replace("'verification': 'unverified',", "'verification': 'cross-checked',")
old_loc = "'locator': '主页目录+四库提要；"
new_loc = "'locator': '主页目录+卷03（天時門·春時：春总论+正二三月经书农书引文，2026-09-25直读）+卷42（勸課門首卷：经书劝农训+历代劝农记事，2026-09-25 curl直读）；主页目录+四库提要；"
assert old_loc in t
t = t.replace(old_loc, new_loc)
t = t.rstrip() + '\n\n## 卷次读取记录\n\n- 卷03、卷42（2026-09-25，R10-R11）。异文登记：卷03引齐民要术种谷句作「穀雨三月上旬及清明節桃始華爲中時」，与齐民要术直读本「三月上旬及清明節、桃始花爲中時」有「穀雨」前缀与「華/花」之异——已在种谷时序卡登记。\n'
io.open(p, 'w', encoding='utf-8', newline='\n').write(t)
print('sstk source updated')


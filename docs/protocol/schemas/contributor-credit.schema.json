{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "contribution": {
      "type": "string",
      "enum": [
        "Music",
        "Visual",
        "Research",
        "Code",
        "Translation"
      ]
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name",
    "location",
    "contribution",
    "detail",
    "license",
    "url"
  ],
  "additionalProperties": false
}
